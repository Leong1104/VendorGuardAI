# Supabase — project "vendorguard" (kukdgmjbltdopfiucuds)
NEXT_PUBLIC_SUPABASE_URL=https://kukdgmjbltdopfiucuds.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Copy the "secret" key from
# https://supabase.com/dashboard/project/kukdgmjbltdopfiucuds/settings/api-keys
# NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Gemini — used for document extraction, classification, and explanations
# https://aistudio.google.com/apikey
# Optional. When unset, the app uses the built-in local text-layer parser and
# template narrator instead of Gemini (no external AI calls at all).
GEMINI_API_KEY=...
# Optional override: "local" | "gemini". Default: gemini if a key is set, else local.
# AI_PROVIDER=local
